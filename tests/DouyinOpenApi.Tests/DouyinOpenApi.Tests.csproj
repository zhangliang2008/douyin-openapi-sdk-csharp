<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 同时挂 net472：用真实的 .NET Framework 运行时验证「4.7 兼容」不是纸面承诺 -->
    <TargetFrameworks>net47;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- net472 默认语言版本是 7.3，而 nullable 引用类型需要 8.0+；测试工程不限制语言版本 -->
    <LangVersion>latest</LangVersion>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DouyinOpenApi\DouyinOpenApi.csproj" />
  </ItemGroup>

</Project>
